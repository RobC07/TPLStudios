---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact Us — TPL Studios"
  description="Tell us about your project and we'll get back to you within 24 hours. Free quotes for UK small businesses."
>
  <!-- Page Header -->
  <section class="section-padding pt-32 md:pt-40">
    <div class="container text-center">
      <h1 class="reveal mb-4">Let's <span class="text-accent-primary">Talk</span></h1>
      <p class="reveal text-txt-secondary text-lg md:text-xl max-w-2xl mx-auto">
        Tell us about your project and we'll get back to you within 24 hours.
      </p>
    </div>
  </section>

  <!-- Contact Form & Sidebar -->
  <section class="section-padding pt-8">
    <div class="container">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-12">
        <!-- Form -->
        <div class="lg:col-span-2">
          <form
            id="contact-form"
            class="card reveal p-6 md:p-8 space-y-6"
            action="https://formspree.io/f/placeholder"
            method="POST"
            novalidate
          >
            <!-- Honeypot -->
            <div class="hidden" aria-hidden="true">
              <label for="website">Website</label>
              <input type="text" id="website" name="_gotcha" tabindex="-1" autocomplete="off" />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <!-- Full Name -->
              <div>
                <label for="name" class="block text-sm font-medium text-txt-primary mb-2">
                  Full Name <span class="text-error" aria-label="required">*</span>
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  class="w-full bg-surface border border-border rounded-input px-4 py-3 text-txt-primary text-sm placeholder:text-txt-tertiary focus:border-accent-primary focus:outline-none transition-colors duration-200"
                  placeholder="John Smith"
                />
                <p class="text-error text-xs mt-1 hidden" id="name-error">Please enter your name.</p>
              </div>

              <!-- Email -->
              <div>
                <label for="email" class="block text-sm font-medium text-txt-primary mb-2">
                  Email Address <span class="text-error" aria-label="required">*</span>
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  class="w-full bg-surface border border-border rounded-input px-4 py-3 text-txt-primary text-sm placeholder:text-txt-tertiary focus:border-accent-primary focus:outline-none transition-colors duration-200"
                  placeholder="john@example.com"
                />
                <p class="text-error text-xs mt-1 hidden" id="email-error">Please enter a valid email address.</p>
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <!-- Phone -->
              <div>
                <label for="phone" class="block text-sm font-medium text-txt-primary mb-2">
                  Phone Number
                </label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  class="w-full bg-surface border border-border rounded-input px-4 py-3 text-txt-primary text-sm placeholder:text-txt-tertiary focus:border-accent-primary focus:outline-none transition-colors duration-200"
                  placeholder="07123 456789"
                />
              </div>

              <!-- Business Name -->
              <div>
                <label for="business" class="block text-sm font-medium text-txt-primary mb-2">
                  Business Name
                </label>
                <input
                  type="text"
                  id="business"
                  name="business"
                  class="w-full bg-surface border border-border rounded-input px-4 py-3 text-txt-primary text-sm placeholder:text-txt-tertiary focus:border-accent-primary focus:outline-none transition-colors duration-200"
                  placeholder="Your Business Ltd"
                />
              </div>
            </div>

            <!-- Project Details -->
            <div>
              <label for="details" class="block text-sm font-medium text-txt-primary mb-2">
                Project Details <span class="text-error" aria-label="required">*</span>
              </label>
              <textarea
                id="details"
                name="message"
                required
                rows="5"
                class="w-full bg-surface border border-border rounded-input px-4 py-3 text-txt-primary text-sm placeholder:text-txt-tertiary focus:border-accent-primary focus:outline-none transition-colors duration-200 resize-y"
                placeholder="Tell us a bit about your business and what you're looking for…"
              ></textarea>
              <p class="text-error text-xs mt-1 hidden" id="details-error">Please tell us about your project.</p>
            </div>

            <!-- Submit -->
            <button type="submit" class="btn-primary w-full sm:w-auto" id="submit-btn">
              Send Enquiry
            </button>

            <!-- Success message -->
            <div id="form-success" class="hidden p-4 bg-success/10 border border-success/30 rounded-card">
              <p class="text-success font-medium text-sm">Thanks! We'll be in touch within 24 hours.</p>
            </div>

            <!-- Error message -->
            <div id="form-error" class="hidden p-4 bg-error/10 border border-error/30 rounded-card">
              <p class="text-error font-medium text-sm">Something went wrong. Please try again or email us directly.</p>
            </div>
          </form>
        </div>

        <!-- Sidebar -->
        <aside class="reveal">
          <div class="card p-6 md:p-8 sticky top-24">
            <h3 class="text-lg mb-6">Contact Details</h3>

            <div class="space-y-6">
              <div>
                <p class="text-txt-tertiary text-xs uppercase tracking-wider mb-1">Email</p>
                <a
                  href="mailto:info@tplstudios.com"
                  class="text-accent-primary hover:text-accent-primary-hover transition-colors duration-200 text-sm"
                >
                  info@tplstudios.com
                </a>
              </div>

              <div>
                <p class="text-txt-tertiary text-xs uppercase tracking-wider mb-1">Response Time</p>
                <p class="text-txt-secondary text-sm">We typically reply within 24 hours</p>
              </div>

              <div>
                <p class="text-txt-tertiary text-xs uppercase tracking-wider mb-3">Follow Us</p>
                <div class="flex gap-4">
                  <a
                    href="https://instagram.com/tplstudios"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-txt-secondary hover:text-accent-primary transition-colors duration-200"
                    aria-label="Follow us on Instagram"
                  >
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z" />
                    </svg>
                  </a>
                  <a
                    href="https://linkedin.com/company/tplstudios"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-txt-secondary hover:text-accent-primary transition-colors duration-200"
                    aria-label="Follow us on LinkedIn"
                  >
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                    </svg>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- Form Validation Script -->
  <script>
    function initContactForm() {
      const form = document.getElementById('contact-form') as HTMLFormElement | null;
      if (!form) return;

      const submitBtn = document.getElementById('submit-btn');
      const successMsg = document.getElementById('form-success');
      const errorMsg = document.getElementById('form-error');

      function showError(fieldId: string) {
        const errEl = document.getElementById(`${fieldId}-error`);
        const input = document.getElementById(fieldId) as HTMLInputElement | null;
        if (errEl) errEl.classList.remove('hidden');
        if (input) input.classList.add('border-error');
      }

      function clearError(fieldId: string) {
        const errEl = document.getElementById(`${fieldId}-error`);
        const input = document.getElementById(fieldId) as HTMLInputElement | null;
        if (errEl) errEl.classList.add('hidden');
        if (input) input.classList.remove('border-error');
      }

      // Clear errors on input
      ['name', 'email', 'details'].forEach((id) => {
        const el = document.getElementById(id);
        if (el) {
          el.addEventListener('input', () => clearError(id));
        }
      });

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        let valid = true;

        // Validate name
        const name = (document.getElementById('name') as HTMLInputElement).value.trim();
        if (!name) { showError('name'); valid = false; } else { clearError('name'); }

        // Validate email
        const email = (document.getElementById('email') as HTMLInputElement).value.trim();
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!email || !emailRegex.test(email)) { showError('email'); valid = false; } else { clearError('email'); }

        // Validate details
        const details = (document.getElementById('details') as HTMLTextAreaElement).value.trim();
        if (!details) { showError('details'); valid = false; } else { clearError('details'); }

        if (!valid) return;

        // Submit
        if (submitBtn) submitBtn.textContent = 'Sending...';
        successMsg?.classList.add('hidden');
        errorMsg?.classList.add('hidden');

        try {
          const formData = new FormData(form);
          const response = await fetch(form.action, {
            method: 'POST',
            body: formData,
            headers: { Accept: 'application/json' },
          });

          if (response.ok) {
            successMsg?.classList.remove('hidden');
            form.reset();
          } else {
            errorMsg?.classList.remove('hidden');
          }
        } catch {
          errorMsg?.classList.remove('hidden');
        } finally {
          if (submitBtn) submitBtn.textContent = 'Send Enquiry';
        }
      });
    }

    document.addEventListener('astro:page-load', initContactForm);
    initContactForm();
  </script>
</BaseLayout>
