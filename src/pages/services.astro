---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Services & Pricing — TPL Studios"
  description="Transparent pricing for professional web design. No hidden fees, no surprises. See our Starter, Growth, and Premium tiers."
>
  <!-- Page Header -->
  <section class="section-padding pt-32 md:pt-40 relative overflow-hidden">
    <div class="orb w-[500px] h-[500px] -top-32 right-0 bg-accent-primary/8 animate-float-slow" aria-hidden="true"></div>
    <div class="absolute inset-0 dot-pattern opacity-20" aria-hidden="true"></div>
    <div class="container relative z-10 text-center">
      <span class="reveal inline-block px-4 py-1.5 text-xs font-mono tracking-wider text-accent-primary border border-accent-primary/30 rounded-full bg-accent-primary/5 mb-6">
        SERVICES & PRICING
      </span>
      <h1 class="reveal mb-4">Services & <span class="gradient-text">Pricing</span></h1>
      <p class="reveal text-txt-secondary text-lg md:text-xl max-w-2xl mx-auto">
        No hidden fees. No surprises. Just clear, honest pricing.
      </p>
    </div>
  </section>

  <!-- Pricing Tiers -->
  <section class="section-padding pt-8 relative">
    <div class="container">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8 stagger">
        <!-- Starter -->
        <div class="card reveal p-8">
          <h3 class="text-accent-secondary mb-2">Starter</h3>
          <p class="text-txt-secondary text-sm mb-4">Perfect for getting online fast.</p>
          <p class="font-heading font-bold text-5xl text-txt-primary mb-1">£299</p>
          <p class="text-txt-tertiary text-sm mb-8">One-off payment</p>
          <ul class="space-y-3 mb-8 text-txt-secondary text-sm">
            <li class="flex gap-3"><span class="text-accent-primary shrink-0" aria-hidden="true">&#10003;</span> Single-page website</li>
            <li class="flex gap-3"><span class="text-accent-primary shrink-0" aria-hidden="true">&#10003;</span> Mobile responsive design</li>
            <li class="flex gap-3"><span class="text-accent-primary shrink-0" aria-hidden="true">&#10003;</span> Contact form integration</li>
            <li class="flex gap-3"><span class="text-accent-primary shrink-0" aria-hidden="true">&#10003;</span> Basic SEO setup</li>
            <li class="flex gap-3"><span class="text-accent-primary shrink-0" aria-hidden="true">&#10003;</span> 2 rounds of revisions</li>
            <li class="flex gap-3"><span class="text-accent-primary shrink-0" aria-hidden="true">&#10003;</span> 14-day delivery</li>
          </ul>
          <a href="/contact" class="btn-secondary w-full">Get Started</a>
        </div>

        <!-- Growth (highlighted) -->
        <div class="card-featured reveal p-8 relative">
          <span class="absolute -top-3 left-1/2 -translate-x-1/2 z-10 text-xs font-heading font-semibold px-4 py-1 rounded-full text-white" style="background: linear-gradient(135deg, #7C3AED, #06B6D4);">
            Most Popular
          </span>
          <h3 class="gradient-text-subtle mb-2">Growth</h3>
          <p class="text-txt-secondary text-sm mb-4">For businesses ready to grow online.</p>
          <p class="font-heading font-bold text-5xl text-txt-primary mb-1">£499</p>
          <p class="text-txt-tertiary text-sm mb-8">One-off payment</p>
          <ul class="space-y-3 mb-8 text-txt-secondary text-sm">
            <li class="flex gap-3"><span class="text-accent-primary shrink-0" aria-hidden="true">&#10003;</span> Multi-page website (up to 4 pages)</li>
            <li class="flex gap-3"><span class="text-accent-primary shrink-0" aria-hidden="true">&#10003;</span> Custom design tailored to your brand</li>
            <li class="flex gap-3"><span class="text-accent-primary shrink-0" aria-hidden="true">&#10003;</span> Full SEO optimisation</li>
            <li class="flex gap-3"><span class="text-accent-primary shrink-0" aria-hidden="true">&#10003;</span> Contact form + Google Maps</li>
            <li class="flex gap-3"><span class="text-accent-primary shrink-0" aria-hidden="true">&#10003;</span> Social media integration</li>
            <li class="flex gap-3"><span class="text-accent-primary shrink-0" aria-hidden="true">&#10003;</span> 3 rounds of revisions</li>
            <li class="flex gap-3"><span class="text-accent-primary shrink-0" aria-hidden="true">&#10003;</span> 14-day delivery</li>
          </ul>
          <a href="/contact" class="btn-primary w-full"><span>Get Started</span></a>
        </div>

        <!-- Premium -->
        <div class="card reveal p-8">
          <h3 class="text-accent-secondary mb-2">Premium</h3>
          <p class="text-txt-secondary text-sm mb-4">The full package for serious businesses.</p>
          <p class="font-heading font-bold text-5xl text-txt-primary mb-1">£749</p>
          <p class="text-txt-tertiary text-sm mb-8">One-off payment</p>
          <ul class="space-y-3 mb-8 text-txt-secondary text-sm">
            <li class="flex gap-3"><span class="text-accent-primary shrink-0" aria-hidden="true">&#10003;</span> Unlimited pages</li>
            <li class="flex gap-3"><span class="text-accent-primary shrink-0" aria-hidden="true">&#10003;</span> Bespoke design with animations</li>
            <li class="flex gap-3"><span class="text-accent-primary shrink-0" aria-hidden="true">&#10003;</span> Advanced SEO + analytics setup</li>
            <li class="flex gap-3"><span class="text-accent-primary shrink-0" aria-hidden="true">&#10003;</span> Priority support</li>
            <li class="flex gap-3"><span class="text-accent-primary shrink-0" aria-hidden="true">&#10003;</span> Unlimited revisions</li>
            <li class="flex gap-3"><span class="text-accent-primary shrink-0" aria-hidden="true">&#10003;</span> 14-day delivery</li>
          </ul>
          <a href="/contact" class="btn-secondary w-full">Get Started</a>
        </div>
      </div>
    </div>
  </section>

  <div class="glow-line" aria-hidden="true"></div>

  <!-- Hosting & Maintenance -->
  <section class="section-padding relative overflow-hidden" style="background: rgba(12, 12, 20, 0.5);">
    <div class="orb w-[400px] h-[400px] -left-32 top-0 bg-accent-secondary/5 animate-pulse-glow" aria-hidden="true"></div>
    <div class="container relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <span class="reveal inline-block px-4 py-1.5 text-xs font-mono tracking-wider text-accent-secondary border border-accent-secondary/30 rounded-full bg-accent-secondary/5 mb-6">
          MONTHLY PLAN
        </span>
        <h2 class="reveal mb-4">Hosting & <span class="gradient-text-subtle">Maintenance</span></h2>
        <p class="reveal text-txt-secondary text-lg mb-10">
          Keep your site fast, secure, and up to date with our monthly plan.
        </p>
      </div>
      <div class="max-w-2xl mx-auto card-featured reveal p-8">
        <div class="text-center mb-8">
          <p class="font-heading font-bold text-4xl text-txt-primary">£75<span class="text-txt-tertiary text-lg font-normal">/month</span></p>
        </div>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-txt-secondary text-sm">
          <li class="flex gap-3"><span class="text-accent-primary shrink-0" aria-hidden="true">&#10003;</span> Fast, reliable hosting</li>
          <li class="flex gap-3"><span class="text-accent-primary shrink-0" aria-hidden="true">&#10003;</span> SSL certificate included</li>
          <li class="flex gap-3"><span class="text-accent-primary shrink-0" aria-hidden="true">&#10003;</span> Monthly backups</li>
          <li class="flex gap-3"><span class="text-accent-primary shrink-0" aria-hidden="true">&#10003;</span> Security updates</li>
          <li class="flex gap-3"><span class="text-accent-primary shrink-0" aria-hidden="true">&#10003;</span> Uptime monitoring</li>
          <li class="flex gap-3"><span class="text-accent-primary shrink-0" aria-hidden="true">&#10003;</span> Email support</li>
          <li class="flex gap-3"><span class="text-accent-primary shrink-0" aria-hidden="true">&#10003;</span> Performance optimisation</li>
        </ul>
      </div>
    </div>
  </section>

  <div class="glow-line" aria-hidden="true"></div>

  <!-- FAQ -->
  <section class="section-padding relative">
    <div class="container max-w-3xl relative z-10">
      <div class="text-center mb-16">
        <span class="reveal inline-block px-4 py-1.5 text-xs font-mono tracking-wider text-accent-tertiary border border-accent-tertiary/30 rounded-full bg-accent-tertiary/5 mb-6">
          FAQ
        </span>
        <h2 class="reveal">Frequently asked <span class="gradient-text-subtle">questions</span></h2>
      </div>
      <div class="space-y-4 stagger">
        {[
          {
            q: 'How long does it take to build my website?',
            a: 'All of our plans are delivered within 14 days. We\'ll give you a clear timeline in your custom quote so you know exactly what to expect.',
          },
          {
            q: 'What do I need to provide?',
            a: 'Just your content — text, images, logo (if you have one), and any specific ideas. We handle everything else. Don\'t worry if you\'re not sure — we\'ll guide you.',
          },
          {
            q: 'What if I need more revisions?',
            a: 'Each plan includes a set number of revisions. If you need extras, we\'ll work something out — we\'re not going to nickel-and-dime you.',
          },
          {
            q: 'Do I have to sign a long contract?',
            a: 'Nope. The website build is a one-off payment. The hosting plan is monthly and you can cancel anytime with 30 days\' notice.',
          },
          {
            q: 'Do you work with businesses outside the UK?',
            a: 'Absolutely. While most of our clients are UK-based, we\'re happy to work with businesses further afield. Get in touch and we\'ll be glad to discuss your project.',
          },
        ].map((faq, i) => (
          <details class="card reveal group cursor-pointer" id={`faq-${i}`}>
            <summary class="flex items-center justify-between gap-4 font-heading font-semibold text-txt-primary list-none [&::-webkit-details-marker]:hidden">
              {faq.q}
              <svg
                class="w-5 h-5 shrink-0 text-accent-primary transition-transform duration-300 group-open:rotate-180"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <p class="mt-4 text-txt-secondary text-sm leading-relaxed">{faq.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <div class="glow-line" aria-hidden="true"></div>

  <!-- CTA -->
  <section class="section-padding relative overflow-hidden" style="background: rgba(12, 12, 20, 0.5);">
    <div class="orb w-[500px] h-[500px] top-0 left-1/2 -translate-x-1/2 bg-accent-primary/8 animate-pulse-glow" aria-hidden="true"></div>
    <div class="absolute inset-0 dot-pattern opacity-15" aria-hidden="true"></div>
    <div class="container relative z-10 text-center">
      <h2 class="reveal mb-4">Know what you <span class="gradient-text">need</span>?</h2>
      <p class="reveal text-txt-secondary text-lg max-w-lg mx-auto mb-10">
        Get in touch and we'll put together a quote within 24 hours.
      </p>
      <div class="reveal">
        <a href="/contact" class="btn-primary text-lg px-10 py-5"><span>Get a Free Quote</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
