---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="TPL Studios — Websites That Work for Your Business"
  description="UK-based web design agency building fast, modern websites for small businesses at prices that make sense. Get a free quote today."
>
  <!-- Hero Section -->
  <section class="relative min-h-screen flex items-center justify-center overflow-hidden">
    <!-- Animated Background Canvas -->
    <canvas id="hero-canvas" class="absolute inset-0 w-full h-full" aria-hidden="true"></canvas>

    <!-- Floating orbs -->
    <div class="orb w-[600px] h-[600px] -top-64 -right-64 bg-accent-primary/10 animate-float" aria-hidden="true"></div>
    <div class="orb w-[400px] h-[400px] -bottom-32 -left-32 bg-accent-secondary/10 animate-float-slow" aria-hidden="true"></div>
    <div class="orb w-[300px] h-[300px] top-1/3 left-1/4 bg-accent-tertiary/5 animate-float-slower" aria-hidden="true"></div>

    <!-- Gradient overlay -->
    <div class="absolute inset-0 bg-gradient-to-b from-bg-primary/60 via-transparent to-bg-primary" aria-hidden="true"></div>

    <!-- Dot pattern overlay -->
    <div class="absolute inset-0 dot-pattern opacity-30" aria-hidden="true"></div>

    <div class="container relative z-10 text-center py-20">
      <div class="reveal mb-4">
        <span class="inline-block px-4 py-1.5 text-xs font-mono tracking-wider text-accent-primary border border-accent-primary/30 rounded-full bg-accent-primary/5 mb-8">
          WEB DESIGN &amp; DEVELOPMENT
        </span>
      </div>
      <h1 class="reveal mb-6 max-w-5xl mx-auto">
        We build websites that
        <span class="gradient-text">actually work</span>
        for your business
      </h1>
      <p class="reveal text-txt-secondary text-lg md:text-xl max-w-2xl mx-auto mb-12 leading-relaxed">
        Fast, modern websites for UK small businesses — at prices that make sense.
        No jargon. No surprises. Just results.
      </p>
      <div class="reveal flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact" class="btn-primary text-lg px-8 py-4"><span>Get a Free Quote</span></a>
        <a href="/portfolio" class="btn-secondary text-lg px-8 py-4">See Our Work</a>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10" aria-hidden="true">
      <div class="w-6 h-10 border-2 border-txt-tertiary/30 rounded-full flex justify-center pt-2">
        <div class="w-1 h-2.5 bg-accent-primary rounded-full animate-bounce"></div>
      </div>
    </div>
  </section>

  <!-- Glow divider -->
  <div class="glow-line" aria-hidden="true"></div>

  <!-- Services Snapshot -->
  <section class="section-padding relative overflow-hidden">
    <div class="orb w-[500px] h-[500px] -right-64 top-0 bg-accent-primary/5 animate-pulse-glow" aria-hidden="true"></div>
    <div class="container relative z-10">
      <div class="text-center mb-20">
        <span class="reveal inline-block px-4 py-1.5 text-xs font-mono tracking-wider text-accent-secondary border border-accent-secondary/30 rounded-full bg-accent-secondary/5 mb-6">
          PRICING
        </span>
        <h2 class="reveal mb-4">Simple, honest <span class="gradient-text-subtle">pricing</span></h2>
        <p class="reveal text-txt-secondary text-lg max-w-xl mx-auto">
          No hidden fees. Pick a plan that fits your business and budget.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8 stagger">
        <!-- Starter -->
        <div class="card reveal text-center p-8">
          <h3 class="text-accent-secondary mb-2">Starter</h3>
          <p class="font-heading font-bold text-5xl text-txt-primary mb-1">£299</p>
          <p class="text-txt-tertiary text-sm mb-8">One-off payment</p>
          <ul class="text-left space-y-3 mb-8 text-txt-secondary text-sm">
            <li class="flex gap-3"><span class="text-accent-primary" aria-hidden="true">&#10003;</span> Single-page website</li>
            <li class="flex gap-3"><span class="text-accent-primary" aria-hidden="true">&#10003;</span> Mobile responsive</li>
            <li class="flex gap-3"><span class="text-accent-primary" aria-hidden="true">&#10003;</span> Contact form</li>
            <li class="flex gap-3"><span class="text-accent-primary" aria-hidden="true">&#10003;</span> 2 rounds of revisions</li>
          </ul>
          <a href="/services" class="btn-secondary w-full">Learn More</a>
        </div>

        <!-- Growth (featured) -->
        <div class="card-featured reveal text-center p-8 relative">
          <span class="absolute -top-3 left-1/2 -translate-x-1/2 z-10 text-xs font-heading font-semibold px-4 py-1 rounded-full text-white" style="background: linear-gradient(135deg, #7C3AED, #06B6D4);">
            Most Popular
          </span>
          <h3 class="gradient-text-subtle mb-2">Growth</h3>
          <p class="font-heading font-bold text-5xl text-txt-primary mb-1">£499</p>
          <p class="text-txt-tertiary text-sm mb-8">One-off payment</p>
          <ul class="text-left space-y-3 mb-8 text-txt-secondary text-sm">
            <li class="flex gap-3"><span class="text-accent-primary" aria-hidden="true">&#10003;</span> Multi-page website (up to 4)</li>
            <li class="flex gap-3"><span class="text-accent-primary" aria-hidden="true">&#10003;</span> Custom design</li>
            <li class="flex gap-3"><span class="text-accent-primary" aria-hidden="true">&#10003;</span> SEO optimised</li>
            <li class="flex gap-3"><span class="text-accent-primary" aria-hidden="true">&#10003;</span> 3 rounds of revisions</li>
          </ul>
          <a href="/services" class="btn-primary w-full"><span>Learn More</span></a>
        </div>

        <!-- Premium -->
        <div class="card reveal text-center p-8">
          <h3 class="text-accent-secondary mb-2">Premium</h3>
          <p class="font-heading font-bold text-5xl text-txt-primary mb-1">£749</p>
          <p class="text-txt-tertiary text-sm mb-8">One-off payment</p>
          <ul class="text-left space-y-3 mb-8 text-txt-secondary text-sm">
            <li class="flex gap-3"><span class="text-accent-primary" aria-hidden="true">&#10003;</span> Unlimited pages</li>
            <li class="flex gap-3"><span class="text-accent-primary" aria-hidden="true">&#10003;</span> Advanced animations</li>
            <li class="flex gap-3"><span class="text-accent-primary" aria-hidden="true">&#10003;</span> Priority support</li>
            <li class="flex gap-3"><span class="text-accent-primary" aria-hidden="true">&#10003;</span> Unlimited revisions</li>
          </ul>
          <a href="/services" class="btn-secondary w-full">Learn More</a>
        </div>
      </div>
    </div>
  </section>

  <div class="glow-line" aria-hidden="true"></div>

  <!-- Portfolio Preview -->
  <section class="section-padding relative overflow-hidden" style="background: rgba(12, 12, 20, 0.5);">
    <div class="absolute inset-0 dot-pattern opacity-20" aria-hidden="true"></div>
    <div class="container relative z-10">
      <div class="text-center mb-20">
        <span class="reveal inline-block px-4 py-1.5 text-xs font-mono tracking-wider text-accent-tertiary border border-accent-tertiary/30 rounded-full bg-accent-tertiary/5 mb-6">
          PORTFOLIO
        </span>
        <h2 class="reveal mb-4">Our <span class="gradient-text-subtle">work</span></h2>
        <p class="reveal text-txt-secondary text-lg max-w-xl mx-auto">
          Real websites we've built for real businesses.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 stagger">
        {[
          { name: 'The Local Barber', desc: 'Modern booking site for a high-street barbershop.' },
          { name: 'GreenLeaf Landscaping', desc: 'Portfolio site showcasing garden transformations.' },
          { name: 'Peak Fitness PT', desc: 'Landing page with class schedules and enquiry form.' },
        ].map((project) => (
          <div class="card reveal overflow-hidden group p-0">
            <div class="aspect-video bg-gradient-to-br from-accent-primary/10 via-surface to-accent-secondary/10 flex items-center justify-center relative overflow-hidden">
              <div class="absolute inset-0 bg-gradient-to-t from-bg-primary/80 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
              <span class="text-txt-tertiary text-sm font-mono">Project Screenshot</span>
            </div>
            <div class="p-6">
              <h3 class="text-lg mb-1 group-hover:text-accent-primary transition-colors duration-300">{project.name}</h3>
              <p class="text-txt-secondary text-sm">{project.desc}</p>
            </div>
          </div>
        ))}
      </div>
      <div class="text-center mt-12 reveal">
        <a href="/portfolio" class="btn-secondary">View All Projects</a>
      </div>
    </div>
  </section>

  <div class="glow-line" aria-hidden="true"></div>

  <!-- Process Teaser -->
  <section class="section-padding relative overflow-hidden">
    <div class="orb w-[400px] h-[400px] -left-48 top-1/3 bg-accent-secondary/5 animate-pulse-glow" aria-hidden="true"></div>
    <div class="container relative z-10 text-center">
      <span class="reveal inline-block px-4 py-1.5 text-xs font-mono tracking-wider text-accent-primary border border-accent-primary/30 rounded-full bg-accent-primary/5 mb-6">
        OUR PROCESS
      </span>
      <h2 class="reveal mb-4">How we <span class="gradient-text-subtle">work</span></h2>
      <p class="reveal text-txt-secondary text-lg max-w-xl mx-auto mb-16">
        From first chat to live site — six simple steps.
      </p>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-6 stagger mb-12">
        {[
          { num: '01', title: 'Discovery Call' },
          { num: '02', title: 'Custom Quote' },
          { num: '03', title: '25% Deposit' },
          { num: '04', title: 'We Build' },
          { num: '05', title: 'Review' },
          { num: '06', title: 'Launch' },
        ].map((step) => (
          <div class="reveal text-center group">
            <div class="w-16 h-16 mx-auto mb-4 rounded-2xl flex items-center justify-center transition-all duration-500 group-hover:scale-110" style="background: linear-gradient(135deg, rgba(124, 58, 237, 0.15), rgba(6, 182, 212, 0.15)); border: 1px solid rgba(124, 58, 237, 0.2);">
              <span class="font-heading font-bold text-lg gradient-text">{step.num}</span>
            </div>
            <span class="text-txt-secondary text-sm">{step.title}</span>
          </div>
        ))}
      </div>
      <div class="reveal">
        <a href="/process" class="btn-secondary">See How We Work</a>
      </div>
    </div>
  </section>

  <div class="glow-line" aria-hidden="true"></div>

  <!-- Final CTA -->
  <section class="section-padding relative overflow-hidden" style="background: rgba(12, 12, 20, 0.5);">
    <div class="orb w-[500px] h-[500px] top-0 left-1/2 -translate-x-1/2 bg-accent-primary/8 animate-pulse-glow" aria-hidden="true"></div>
    <div class="absolute inset-0 dot-pattern opacity-15" aria-hidden="true"></div>
    <div class="container relative z-10 text-center">
      <h2 class="reveal mb-4">Ready to get <span class="gradient-text">started</span>?</h2>
      <p class="reveal text-txt-secondary text-lg max-w-lg mx-auto mb-10">
        Tell us about your project and we'll get back to you within 24 hours.
      </p>
      <div class="reveal">
        <a href="/contact" class="btn-primary text-lg px-10 py-5"><span>Get in Touch</span></a>
      </div>
    </div>
  </section>

  <!-- Hero Canvas Script -->
  <script>
    function initHeroCanvas() {
      const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement | null;
      if (!canvas) return;

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (prefersReducedMotion) return;

      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      let animationId: number;
      let mouseX = 0;
      let mouseY = 0;
      let particles: Array<{
        x: number; y: number; vx: number; vy: number; size: number; opacity: number; color: string; baseOpacity: number;
      }> = [];

      function resize() {
        canvas!.width = window.innerWidth;
        canvas!.height = window.innerHeight;
      }

      function createParticles() {
        const count = Math.min(80, Math.floor(window.innerWidth / 16));
        particles = [];
        for (let i = 0; i < count; i++) {
          const baseOpacity = Math.random() * 0.4 + 0.1;
          particles.push({
            x: Math.random() * canvas!.width,
            y: Math.random() * canvas!.height,
            vx: (Math.random() - 0.5) * 0.4,
            vy: (Math.random() - 0.5) * 0.4,
            size: Math.random() * 2.5 + 0.5,
            opacity: baseOpacity,
            baseOpacity,
            color: ['124, 58, 237', '6, 182, 212', '236, 72, 153'][Math.floor(Math.random() * 3)],
          });
        }
      }

      canvas.addEventListener('mousemove', (e) => {
        mouseX = e.clientX;
        mouseY = e.clientY;
      });

      function draw() {
        ctx!.clearRect(0, 0, canvas!.width, canvas!.height);

        for (const p of particles) {
          // Mouse interaction — glow brighter near cursor
          const dx = mouseX - p.x;
          const dy = mouseY - p.y;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < 200) {
            p.opacity = p.baseOpacity + (1 - dist / 200) * 0.5;
            p.size = p.size < 4 ? p.size + 0.02 : p.size;
          } else {
            p.opacity += (p.baseOpacity - p.opacity) * 0.02;
          }

          p.x += p.vx;
          p.y += p.vy;

          if (p.x < 0) p.x = canvas!.width;
          if (p.x > canvas!.width) p.x = 0;
          if (p.y < 0) p.y = canvas!.height;
          if (p.y > canvas!.height) p.y = 0;

          ctx!.beginPath();
          ctx!.arc(p.x, p.y, p.size, 0, Math.PI * 2);
          ctx!.fillStyle = `rgba(${p.color}, ${p.opacity})`;
          ctx!.fill();
        }

        // Draw connections with gradient colors
        for (let i = 0; i < particles.length; i++) {
          for (let j = i + 1; j < particles.length; j++) {
            const dx = particles[i].x - particles[j].x;
            const dy = particles[i].y - particles[j].y;
            const dist = Math.sqrt(dx * dx + dy * dy);
            if (dist < 160) {
              const alpha = 0.08 * (1 - dist / 160);
              ctx!.beginPath();
              ctx!.moveTo(particles[i].x, particles[i].y);
              ctx!.lineTo(particles[j].x, particles[j].y);
              ctx!.strokeStyle = `rgba(124, 58, 237, ${alpha})`;
              ctx!.lineWidth = 0.5;
              ctx!.stroke();
            }
          }
        }

        animationId = requestAnimationFrame(draw);
      }

      resize();
      createParticles();
      draw();

      window.addEventListener('resize', () => {
        resize();
        createParticles();
      });

      document.addEventListener('astro:before-preparation', () => {
        cancelAnimationFrame(animationId);
      }, { once: true });
    }

    document.addEventListener('astro:page-load', initHeroCanvas);
    initHeroCanvas();
  </script>
</BaseLayout>
