---
import BaseLayout from '../layouts/BaseLayout.astro';

const steps = [
  {
    num: '01',
    title: 'Discovery Call',
    description: 'Book a free call so we can understand your business, goals, and what you need from your website.',
  },
  {
    num: '02',
    title: 'Custom Quote',
    description: "We'll put together a clear, detailed quote tailored to your project — no cookie-cutter pricing.",
  },
  {
    num: '03',
    title: '25% Deposit',
    description: "Once you're happy with the quote, pay a 25% deposit to kick things off.",
  },
  {
    num: '04',
    title: 'We Build Your Site',
    description: 'Our team designs and develops your site, keeping you updated throughout the process.',
  },
  {
    num: '05',
    title: 'Review & Feedback',
    description: "We present the finished site for your review. You get revisions to make sure it's exactly right.",
  },
  {
    num: '06',
    title: 'Launch & Hosting',
    description: 'Pay the remaining balance, we launch your site, and set you up on a monthly hosting & maintenance plan.',
  },
];
---

<BaseLayout
  title="Our Process — TPL Studios"
  description="From first chat to live site — here's exactly how working with TPL Studios works, step by step."
>
  <!-- Page Header -->
  <section class="section-padding pt-32 md:pt-40 relative overflow-hidden">
    <div class="orb w-[500px] h-[500px] -top-32 right-0 bg-accent-secondary/8 animate-float-slow" aria-hidden="true"></div>
    <div class="absolute inset-0 dot-pattern opacity-20" aria-hidden="true"></div>
    <div class="container relative z-10 text-center">
      <span class="reveal inline-block px-4 py-1.5 text-xs font-mono tracking-wider text-accent-primary border border-accent-primary/30 rounded-full bg-accent-primary/5 mb-6">
        OUR PROCESS
      </span>
      <h1 class="reveal mb-4">How We <span class="gradient-text">Work</span></h1>
      <p class="reveal text-txt-secondary text-lg md:text-xl max-w-2xl mx-auto">
        From first chat to live site — here's what to expect.
      </p>
    </div>
  </section>

  <!-- Process Timeline -->
  <section class="section-padding pt-8">
    <div class="container max-w-4xl">
      <div class="relative">
        <!-- Vertical line with gradient -->
        <div class="absolute left-6 md:left-1/2 top-0 bottom-0 w-px md:-translate-x-px" style="background: linear-gradient(180deg, rgba(124, 58, 237, 0.5), rgba(6, 182, 212, 0.5), rgba(236, 72, 153, 0.3));" aria-hidden="true"></div>

        <div class="space-y-12 md:space-y-16">
          {steps.map((step, i) => (
            <div class={`reveal relative flex flex-col md:flex-row items-start gap-6 md:gap-12 ${i % 2 === 1 ? 'md:flex-row-reverse' : ''}`}>
              <!-- Step number dot with glow -->
              <div class="absolute left-6 md:left-1/2 -translate-x-1/2 mt-2 z-10" aria-hidden="true">
                <div class="w-3 h-3 rounded-full" style="background: linear-gradient(135deg, #7C3AED, #06B6D4); box-shadow: 0 0 12px rgba(124, 58, 237, 0.5);"></div>
              </div>

              <div class="hidden md:block md:w-1/2"></div>

              <div class="ml-14 md:ml-0 md:w-1/2">
                <div class="card p-6">
                  <div class="flex items-center gap-3 mb-3">
                    <span class="font-heading font-bold text-2xl gradient-text">{step.num}</span>
                    <h3 class="text-lg">{step.title}</h3>
                  </div>
                  <p class="text-txt-secondary text-sm leading-relaxed">{step.description}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <div class="glow-line" aria-hidden="true"></div>

  <!-- CTA -->
  <section class="section-padding relative overflow-hidden" style="background: rgba(12, 12, 20, 0.5);">
    <div class="orb w-[500px] h-[500px] top-0 left-1/2 -translate-x-1/2 bg-accent-primary/8 animate-pulse-glow" aria-hidden="true"></div>
    <div class="absolute inset-0 dot-pattern opacity-15" aria-hidden="true"></div>
    <div class="container relative z-10 text-center">
      <h2 class="reveal mb-4">Ready to <span class="gradient-text">start</span>?</h2>
      <p class="reveal text-txt-secondary text-lg max-w-lg mx-auto mb-10">
        Step one is easy — just get in touch and we'll take it from there.
      </p>
      <div class="reveal">
        <a href="/contact" class="btn-primary text-lg px-10 py-5"><span>Book Your Free Call</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
