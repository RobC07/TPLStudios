---
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = [
  {
    name: 'The Local Barber',
    description: 'A modern booking and showcase site for a popular high-street barbershop. Clean design with online appointment scheduling.',
    tags: ['Web Design', 'Booking Integration'],
    gradient: 'from-accent-primary/20 to-accent-secondary/10',
  },
  {
    name: 'GreenLeaf Landscaping',
    description: 'Portfolio website showcasing stunning garden transformations with before/after galleries and enquiry form.',
    tags: ['Web Design', 'Portfolio'],
    gradient: 'from-accent-secondary/20 to-accent-tertiary/10',
  },
  {
    name: 'Peak Fitness PT',
    description: 'High-energy landing page with class schedules, trainer profiles, and a lead-capture enquiry form.',
    tags: ['Web Design', 'Landing Page'],
    gradient: 'from-accent-tertiary/20 to-accent-primary/10',
  },
  {
    name: 'Bright Smiles Dental',
    description: 'Professional multi-page site for a local dental clinic featuring service listings and patient testimonials.',
    tags: ['Web Design', 'Branding', 'Hosting'],
    gradient: 'from-accent-primary/15 to-accent-tertiary/15',
  },
  {
    name: 'Home & Hearth Interiors',
    description: 'Elegant portfolio site for an interior design studio with project galleries and consultation booking.',
    tags: ['Web Design', 'Portfolio'],
    gradient: 'from-accent-secondary/15 to-accent-primary/15',
  },
  {
    name: 'QuickFix Plumbing',
    description: 'Fast, mobile-first single-page site with click-to-call, service area map, and emergency contact form.',
    tags: ['Web Design', 'Landing Page', 'Hosting'],
    gradient: 'from-accent-tertiary/15 to-accent-secondary/15',
  },
];
---

<BaseLayout
  title="Portfolio — TPL Studios"
  description="See real websites we've built for UK small businesses. From barbershops to dental clinics, our work speaks for itself."
>
  <!-- Page Header -->
  <section class="section-padding pt-32 md:pt-40 relative overflow-hidden">
    <div class="orb w-[500px] h-[500px] -top-32 -left-32 bg-accent-tertiary/8 animate-float-slow" aria-hidden="true"></div>
    <div class="absolute inset-0 dot-pattern opacity-20" aria-hidden="true"></div>
    <div class="container relative z-10 text-center">
      <span class="reveal inline-block px-4 py-1.5 text-xs font-mono tracking-wider text-accent-tertiary border border-accent-tertiary/30 rounded-full bg-accent-tertiary/5 mb-6">
        PORTFOLIO
      </span>
      <h1 class="reveal mb-4">Our <span class="gradient-text">Work</span></h1>
      <p class="reveal text-txt-secondary text-lg md:text-xl max-w-2xl mx-auto">
        Real results for real businesses.
      </p>
    </div>
  </section>

  <!-- Project Grid -->
  <section class="section-padding pt-8">
    <div class="container">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 stagger">
        {projects.map((project) => (
          <article class="card reveal overflow-hidden group p-0">
            <div class={`aspect-video bg-gradient-to-br ${project.gradient} flex items-center justify-center overflow-hidden relative`}>
              <div class="absolute inset-0 bg-gradient-to-t from-bg-primary/80 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
              <div class="absolute inset-0 dot-pattern opacity-10"></div>
              <span class="text-txt-tertiary text-sm font-mono relative z-10">Project Screenshot</span>
            </div>
            <div class="p-6">
              <h3 class="text-xl mb-2 group-hover:text-accent-primary transition-colors duration-300">{project.name}</h3>
              <p class="text-txt-secondary text-sm mb-4 leading-relaxed">{project.description}</p>
              <div class="flex flex-wrap gap-2">
                {project.tags.map((tag) => (
                  <span class="text-xs font-mono px-3 py-1 rounded-full text-accent-secondary" style="background: rgba(6, 182, 212, 0.1); border: 1px solid rgba(6, 182, 212, 0.2);">{tag}</span>
                ))}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <div class="glow-line" aria-hidden="true"></div>

  <!-- CTA -->
  <section class="section-padding relative overflow-hidden" style="background: rgba(12, 12, 20, 0.5);">
    <div class="orb w-[500px] h-[500px] top-0 left-1/2 -translate-x-1/2 bg-accent-primary/8 animate-pulse-glow" aria-hidden="true"></div>
    <div class="absolute inset-0 dot-pattern opacity-15" aria-hidden="true"></div>
    <div class="container relative z-10 text-center">
      <h2 class="reveal mb-4">Want results like <span class="gradient-text">these</span>?</h2>
      <p class="reveal text-txt-secondary text-lg max-w-lg mx-auto mb-10">
        Let's build something great for your business.
      </p>
      <div class="reveal">
        <a href="/contact" class="btn-primary text-lg px-10 py-5"><span>Start Your Project</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
